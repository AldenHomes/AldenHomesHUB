# Settings for the hub's server piece. Nothing secret belongs in this file —
# the mailbox's app password is stored separately in Firebase's secret storage.

# The Gmail account schedule emails are sent from, and the name subs see.
MAIL_USER=aldenhomesserver@gmail.com
MAIL_NAME=Alden Homes Scheduling
# Where a sub's reply goes. Change this to the office address if replies should land there.
MAIL_REPLY_TO=aldenhomesserver@gmail.com

# Set to 1 once the GMAIL_APP_PASSWORD secret has been stored, then redeploy to switch emailing on.
ENABLE_EMAIL=1
